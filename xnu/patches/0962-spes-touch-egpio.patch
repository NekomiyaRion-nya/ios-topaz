From 80ceedcbe114387cb337213e156cc0490cefb7e2 Mon Sep 17 00:00:00 2001
From: matsu <covocovo893@gmail.com>
Date: Thu, 22 Oct 2026 23:08:21 +0900
Subject: [PATCH] spes-0962: claim eGPIO pins (CFG bit 12 when bit 11 is set,
 as msm_pinmux_set_mux): GPIO98, the FT3418 AVDD enable, is an eGPIO and never
 left the SoC; log the AVDD pad level

---
 bsd/dev/sweet_touch.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 68d3469..666d4a8 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -187,6 +187,15 @@ touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out,
 	}
 	cfg &= ~0x3ffu;
 	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	/*
+	 * spes: khaje pins with EGPIO_PRESENT (bit 11, e.g. GPIO98 = touch AVDD)
+	 * reach the pad only when TLMM claims them with EGPIO_ENABLE (bit 12), as
+	 * pinctrl-msm.c msm_pinmux_set_mux does; otherwise the LPI side keeps the
+	 * pin and our output never leaves the SoC (AVDD stayed low, FT3418 off).
+	 */
+	if (cfg & (1u << 11)) {
+		cfg |= 1u << 12;
+	}
 	touch_wr(tile, off, cfg);
 }
 
@@ -300,7 +309,8 @@ touch_bb_diag(void)
 	/* plain GPIO, pull-up (in case the board's pull-ups are on a dead rail), 2 mA, OUT latch 0 */
 	for (unsigned pin = BB_SDA; pin <= BB_SCL; ++pin) {
 		touch_wr(st.west, TOUCH_GPIO_IO(pin), touch_rd(st.west, TOUCH_GPIO_IO(pin)) & ~2u);
-		touch_wr(st.west, TOUCH_GPIO_CFG(pin), (touch_rd(st.west, TOUCH_GPIO_CFG(pin)) & ~0x3ffu) | 3u);
+		uint32_t c = (touch_rd(st.west, TOUCH_GPIO_CFG(pin)) & ~0x3ffu) | 3u;
+		touch_wr(st.west, TOUCH_GPIO_CFG(pin), (c & (1u << 11)) ? (c | (1u << 12)) : c);
 	}
 	delay(100);
 	bool sda_pu = bb_get(BB_SDA), scl_pu = bb_get(BB_SCL);
@@ -1011,6 +1021,10 @@ touch_thread(void *arg, wait_result_t result)
 	if (!(touch_test & 4u)) {
 		touch_gpio(TOUCH_PIN_AVDD, 0, 3, 3, true, true);        /* CTL 0x2c3, high */
 	}
+	delay(1000);
+	printf("SWEET TOUCH: avdd gpio98 cfg=%#x io=%#x (pad %s)\n",
+	    touch_rd(st.avdd, TOUCH_GPIO_CFG(TOUCH_PIN_AVDD)), touch_rd(st.avdd, TOUCH_GPIO_IO(TOUCH_PIN_AVDD)),
+	    (touch_rd(st.avdd, TOUCH_GPIO_IO(TOUCH_PIN_AVDD)) & 1u) ? "high" : "LOW");
 	touch_stage("power: vcc_i2c l9a");
 	{
 		int l9a = 1;
-- 
