From 27692bf33669e7a7bee910b56c90b8ac86f2e93b Mon Sep 17 00:00:00 2001
From: matsu <covocovo893@gmail.com>
Date: Thu, 22 Oct 2026 21:08:45 +0900
Subject: [PATCH] spes-0162: FT3418 power as the Xiaomi driver does: reset low,
 AVDD, then vcc_i2c (PM6125 L9A over SPMI, sweettouchl9a=0 skips); retry the
 chip id for ~1 s

---
 bsd/dev/sweet_keys.c  | 48 +++++++++++++++++++++++++++++++++++++++++++
 bsd/dev/sweet_touch.c | 26 +++++++++++++++++++++--
 2 files changed, 72 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index c9069c4..be78055 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -117,6 +117,54 @@ keys_write(uint16_t apid, uint16_t addr, uint8_t val)
 	return false;
 }
 
+/*
+ * spes: the FT3418's vcc_i2c is PM6125 L9A (spes dtbo: touchscreen
+ * vcc_i2c-supply = L9A, 1.8 V; the Xiaomi ft3418_i2c driver enables it after
+ * AVDD). Nothing but Bluetooth and the codec use it, so ABL leaves it off and
+ * the IC NACKs. PMIC5 LDO at SID 0 0x4800: TYPE 0x04 (0x21 = LDO), STATUS1
+ * 0x08 (bit 7 VREG_READY), VSET 0x40/0x41 (mV), EN_CTL 0x46 (bit 7).
+ * Enables only an LDO already set to 1.7-1.95 V. Returns true when it is on.
+ */
+bool sweet_pmic_l9a_on(void);
+bool
+sweet_pmic_l9a_on(void)
+{
+	if (!keys_core) {
+		keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
+		keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+		keys_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	}
+	if (!keys_core || !keys_cnfg || !keys_obs) {
+		printf("SWEET L9A: MMIO mapping failed\n");
+		return false;
+	}
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	uint16_t apid = keys_find_apid(0x048, count > 512 ? 512 : count);
+	uint8_t type = 0, status = 0, lb = 0, ub = 0, mode = 0, en = 0;
+	bool ok = keys_read(apid, 0x4804, &type) && keys_read(apid, 0x4808, &status) &&
+	    keys_read(apid, 0x4840, &lb) && keys_read(apid, 0x4841, &ub) &&
+	    keys_read(apid, 0x4845, &mode) && keys_read(apid, 0x4846, &en);
+	unsigned mv = ((unsigned)ub << 8) | lb;
+	printf("SWEET L9A: apid=%u owner=%u read=%d type=%#x status=%#x vset=%u mV mode=%#x en=%#x\n",
+	    apid, apid == KEYS_NO_APID ? 9u : keys_rd(keys_cnfg, 0x700u + 4u * apid) & 7u,
+	    ok, type, status, mv, mode, en);
+	if (!ok || type != 0x21u || mv < 1700u || mv > 1950u) {
+		printf("SWEET L9A: not a 1.8 V LDO as expected; left alone\n");
+		return false;
+	}
+	if (en & 0x80u) {
+		return true;
+	}
+	bool wok = keys_write(apid, 0x4846, (uint8_t)(en | 0x80u));
+	delay(2000);
+	uint8_t en2 = 0, status2 = 0;
+	(void)keys_read(apid, 0x4846, &en2);
+	(void)keys_read(apid, 0x4808, &status2);
+	printf("SWEET L9A: enable write=%d status=%#x en=%#x status1=%#x\n",
+	    wok, keys_last_status, en2, status2);
+	return (en2 & 0x80u) != 0;
+}
+
 /*
  * Make the next PS_HOLD drop land in fastboot, as Linux's msm-poweroff does
  * for "reboot bootloader": PON restart reason BOOTLOADER (2) in SOFT_RB_SPARE
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index ec568bc..9225689 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -24,6 +24,7 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern kern_return_t thread_terminate(thread_t);
 extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
 extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern bool sweet_pmic_l9a_on(void);   /* sweet_keys.c (spes) */
 void sweet_touch_init(void);
 
 #define TOUCH_SE_PA      0x04a88000u /* QUP0 SE2 */
@@ -829,10 +830,22 @@ touch_thread(void *arg, wait_result_t result)
 	/* TopazTouch touch.c: IRQ input, AVDD on, I2C pins, then the reset pulse. */
 	touch_stage("power: irq pin");
 	touch_gpio(TOUCH_PIN_IRQ, 0, 3, 3, false, false);       /* CTL 0xc3 */
+	/* spes (ft3418_i2c fts_power_source_ctrl): reset low, AVDD, then vcc_i2c (L9A) */
+	if (!(touch_test & 8u)) {
+		touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, false);      /* CTL 0x2c3, low */
+	}
 	touch_stage("power: avdd gpio98");
 	if (!(touch_test & 4u)) {
 		touch_gpio(TOUCH_PIN_AVDD, 0, 3, 3, true, true);        /* CTL 0x2c3, high */
 	}
+	touch_stage("power: vcc_i2c l9a");
+	{
+		int l9a = 1;
+		(void)PE_parse_boot_argn("sweettouchl9a", &l9a, sizeof(l9a));
+		printf("SWEET TOUCH: L9A %s\n", !l9a ? "left alone (sweettouchl9a=0)" :
+		    sweet_pmic_l9a_on() ? "on" : "NOT on");
+	}
+	touch_wait(10);
 	touch_stage("power: i2c pins");
 	touch_gpio(6, 1, 0, 0, false, false);                   /* qup2 SDA, CTL 0x4 */
 	touch_gpio(7, 1, 0, 0, false, false);                   /* qup2 SCL */
@@ -853,8 +866,17 @@ touch_thread(void *arg, wait_result_t result)
 	if (!(touch_test & 1u)) {
 		(void)touch_probe_info(0x8240, legacy);
 	}
-	int fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
-	int fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
+	/* spes: FT3418 firmware start after reset can take a while; retry the id for ~1 s */
+	int fe1 = ENXIO, fe2 = ENXIO;
+	for (unsigned tries = 0; tries < 6; ++tries) {
+		fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
+		fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
+		if ((!fe1 && !fe2) || st.dead) {
+			break;
+		}
+		printf("SWEET TOUCH: 0x38 id try %u err=%d/%d\n", tries, fe1, fe2);
+		touch_wait(200);
+	}
 	printf("SWEET TOUCH: probe 0x38 err=%d/%d chip-id=%02x:%02x irq=%#x\n",
 	    fe1, fe2, fid1, fid2, st.irq_status);
 	{
-- 
