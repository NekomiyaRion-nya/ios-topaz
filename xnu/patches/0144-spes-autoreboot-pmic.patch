From 46e2d782e45d29e398fcf9e95ed10b5206776f13 Mon Sep 17 00:00:00 2001
From: matsu <covocovo893@gmail.com>
Date: Thu, 22 Oct 2026 01:40:03 +0900
Subject: [PATCH] spes-0144: sweetautoreboot sets the PMIC reboot reason first

---
 bsd/dev/sweet_ufs.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index fed1e37..5012049 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -864,6 +864,7 @@ static uint32_t sweet_log_secs = SWEET_LOG_SECS;
 #define SWEET_RESTART_BOOTLOADER 0x77665500u
 #define SWEET_PSHOLD_PA          0x0440b000u
 static uint64_t sweet_reboot_at;
+extern bool sweet_pmic_reboot_bootloader(void);  /* bsd/dev/sweet_keys.c */
 
 static void
 sweet_reboot_check(void)
@@ -992,6 +993,7 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 				sweet_reboot_check();   /* the announcement is on disk */
 			}
 			printf("SWEET REBOOT: sweetautoreboot reached, resetting to fastboot\n");
+			(void)sweet_pmic_reboot_bootloader();   /* PON reason + warm reset, logs its result */
 			reboot_announced = true;
 			wakeup(&sweet_log_chan);        /* flush that line, then reset */
 		}
-- 
