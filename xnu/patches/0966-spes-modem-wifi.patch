From 51be636025449083da50afe4985680ba0aeafda5 Mon Sep 17 00:00:00 2001
From: matsu <covocovo893@gmail.com>
Date: Fri, 23 Oct 2026 02:42:23 +0900
Subject: [PATCH] spes-0966: Wi-Fi/modem on spes: firmware tables made from
 this phone's modem_a (tools/modem-fwtable.py), and the 16 MB modem pool moved
 off kernel RAM (0x70000000 when topaz' 0xE0000000 is kernel RAM; modem_pool=
 overrides)

---
 iokit/Kernel/arm/TopazModem.cpp | 2580 +++++++++++++++----------------
 1 file changed, 1251 insertions(+), 1329 deletions(-)

diff --git a/iokit/Kernel/arm/TopazModem.cpp b/iokit/Kernel/arm/TopazModem.cpp
index 8aa0c2f..09cb0cb 100644
--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -44,7 +44,14 @@ extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 #define MDT_RELOCATABLE     (1u << 27)
 
 /* middle DDR bank, RAM the kernel does not manage; below 0xF0000000 for TZ/the modem */
-#define MODEM_POOL_BASE     0xE0000000ull
+/*
+ * spes: topaz' pool at 0xE0000000 is kernel RAM here (mkadt --mem 0x80000000:0xc0000000); then the
+ * pool moves to 0x70000000, free DDR of the first bank above every fixed carve-out (they end at
+ * 0x63900000; the bank at 0x7DD00000). Boot-arg modem_pool= overrides.
+ */
+extern "C" unsigned long gPhysBase, gPhysSize;     /* osfmk/arm64/arm_vm_init.c */
+static uint64_t modem_pool_base = 0xE0000000ull;
+#define MODEM_POOL_BASE     modem_pool_base
 #define MODEM_POOL_SIZE     0x01000000ull       /* 16 MB: metadata, SCM args, rmtfs, CE rings, WMI memory */
 
 #define SMEM_PA             0x46000000ull
@@ -178,34 +185,34 @@ extern "C" int sweet_ufs_read_part(const char *want, uint64_t off, void *dst, ui
 
