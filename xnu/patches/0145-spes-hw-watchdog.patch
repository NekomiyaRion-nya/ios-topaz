From 3ef64af536025c818d8c435dfc755297299f669c Mon Sep 17 00:00:00 2001
From: matsu <covocovo893@gmail.com>
Date: Thu, 22 Oct 2026 02:02:53 +0900
Subject: [PATCH] spes-0145: sweethwwdt=SECS arms the APSS watchdog (hang ->
 bite -> fastboot)

---
 bsd/dev/sweet_keys.c | 70 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 70 insertions(+)

diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 887a6df..c9069c4 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -142,6 +142,75 @@ sweet_pmic_reboot_bootloader(void)
 	return sok;
 }
 
+/*
+ * spes: boot-arg sweethwwdt=SECS arms the APSS watchdog (qcom,msm-watchdog at
+ * 0xf017000, 32 kHz sleep clock, msm_watchdog_v2.c register layout) and pets
+ * it every second from a kernel thread. A hang that stops the kernel (e.g. a
+ * stuck bus access) bites after SECS; the PMIC restart reason is set to
+ * BOOTLOADER up front, so the phone comes back in fastboot for a log pull.
+ * Bark and bite are the same time: when the kernel is alive it always pets
+ * first, so the bark interrupt is never needed.
+ */
+#define WDT_PA          0x0f017000u
+#define WDT_RST         0x04u
+#define WDT_EN          0x08u
+#define WDT_BARK_TIME   0x10u
+#define WDT_BITE_TIME   0x14u
+#define WDT_HZ          32765u
+
+static vm_offset_t keys_wdt;
+static int keys_wdt_chan;
+
+static void
+keys_wdt_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	for (;;) {
+		*(volatile uint32_t *)(keys_wdt + WDT_RST) = 1;
+		__asm__ volatile("dsb sy" ::: "memory");
+		uint64_t deadline;
+		clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&keys_wdt_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static void
+keys_wdt_start(void)
+{
+	uint32_t secs = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("sweethwwdt", &secs, sizeof(secs)) || secs == 0) {
+		return;
+	}
+	if (secs < 5) {
+		secs = 5;
+	}
+	(void)sweet_pmic_reboot_bootloader();
+	keys_wdt = ml_io_map(WDT_PA, 0x1000);
+	if (!keys_wdt) {
+		printf("SWEET WDT: watchdog mapping failed\n");
+		return;
+	}
+	volatile uint32_t *w = (volatile uint32_t *)keys_wdt;
+	w[WDT_EN / 4] = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	w[WDT_BARK_TIME / 4] = secs * WDT_HZ;
+	w[WDT_BITE_TIME / 4] = secs * WDT_HZ;
+	w[WDT_RST / 4] = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+	w[WDT_EN / 4] = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (kernel_thread_start(keys_wdt_thread, NULL, &thread) != KERN_SUCCESS) {
+		w[WDT_EN / 4] = 0;
+		printf("SWEET WDT: pet thread failed, watchdog off\n");
+		return;
+	}
+	thread_deallocate(thread);
+	printf("SWEET WDT: hardware watchdog armed, bite after %u s without a pet -> fastboot\n", secs);
+}
+
 static void
 keys_wait(void)
 {
@@ -233,6 +302,7 @@ sweet_keys_init(void)
 	if (!pok && !gok) {
 		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
 	}
+	keys_wdt_start();       /* needs the PON APID for the restart reason */
 	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
 	if (kr == KERN_SUCCESS) {
 		thread_deallocate(thread);
-- 
