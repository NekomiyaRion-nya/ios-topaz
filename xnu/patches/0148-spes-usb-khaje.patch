From 9695e3789d6675fe963c4e38c098f92cfe7a406a Mon Sep 17 00:00:00 2001
From: matsu <covocovo893@gmail.com>
Date: Thu, 22 Oct 2026 02:07:52 +0900
Subject: [PATCH] spes-0148: USB (DWC3 0x4e00000, gcc-sm6115 clocks, femto PHY)
 for the CDC-ECM live log

---
 bsd/dev/sweet_usb.c | 36 +++++++++++++-----------------------
 1 file changed, 13 insertions(+), 23 deletions(-)

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 9c42e45..a775198 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -41,26 +41,25 @@ extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 
 #define GCC_PA                  0x00100000
 #define GCC_SIZE                0x00090000
-#define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
+#define GCC_USB30_PRIM_GDSCR    0x1a004         /* bit 31: power on (spes: gcc-sm6115.c) */
 #define CBCR_CLK_OFF            (1u << 31)
 
 static const struct {
 	const char *name;
 	uint32_t    off;
 } usb_cbcr[] = {
-	{ "master", 0x0f010 },
-	{ "sleep", 0x0f014 },
-	{ "utmi", 0x0f018 },
-	{ "cfg-noc-axi", 0x0502c },
-	{ "aggre-axi", 0x8201c },
-	{ "ahb2phy", 0x6a004 },
-	{ "clkref", 0x8c010 },
+	/* spes (SM6225 khaje), Linux gcc-sm6115.c */
+	{ "master", 0x1a010 },
+	{ "sleep", 0x1a014 },
+	{ "utmi", 0x1a018 },
+	{ "cfg-noc-axi", 0x1a084 },
+	{ "sys-noc-axi", 0x1a080 },
+	{ "ahb2phy", 0x1d008 },
+	{ "clkref", 0x9f000 },
 };
 
-#define DWC3_PA                 0x0a600000
+#define DWC3_PA                 0x04e00000      /* spes: ssusb@4e00000 core_base */
 #define DWC3_SIZE               0x0000d000
-#define QUSB2_PA                0x088e2000
-#define QUSB2_SIZE              0x00000400
 
 static uint32_t
 usb_rd(vm_offset_t base, uint32_t off)
@@ -116,19 +115,10 @@ sweet_usb_probe(void)
 	if (enabled >= 2) {
 		sweet_usb_gadget_start(dwc);
 	}
+	/* spes: the HS PHY is a Synopsys femto PHY (no QUSB2 registers to report) */
 	if (cbcr[5] & CBCR_CLK_OFF) {
-		printf("SWEET USB: ahb2phy clock off; QUSB2 PHY not read\n");
-		return;
-	}
-	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
-	if (phy == 0) {
-		return;
+		printf("SWEET USB: ahb2phy clock off; PHY not read\n");
 	}
-	/* DT qcom,qusb-phy-reg-offset order (Linux phy-msm-qusb-v2.c): PORT_TUNE1 0x240,
-	 * PLL_COMMON_STATUS_ONE 0x1a0, PWR_CTRL1 0x210, INTR_CTRL 0x230,
-	 * PLL_CORE_INPUT_OVERRIDE 0x0a8, TEST1 0x254. */
-	printf("SWEET USB: QUSB2 PLL_STATUS 0x%08x PWR_CTRL1 0x%08x PORT_TUNE1 0x%08x TEST1 0x%08x\n",
-	    usb_rd(phy, 0x1a0), usb_rd(phy, 0x210), usb_rd(phy, 0x240), usb_rd(phy, 0x254));
 }
 
 /*
@@ -164,7 +154,7 @@ sweet_usb_probe(void)
  * session; Linux dwc3-qcom forces that in software when the charger
  * reports a cable (dwc3_qcom_vbus_override_enable).
  */
-#define QSCRATCH_PA             0x0a6f8800
+#define QSCRATCH_PA             0x04ef8800      /* spes: core_base + 0xf8800 */
 #define QSCRATCH_HS_PHY_CTRL    0x10
 #define   UTMI_OTG_VBUS_VALID   (1u << 20)
 #define   SW_SESSVLD_SEL        (1u << 28)
-- 
2.52.0.windows.1

