From 40a4b176461049033e5b438802f1e7eb810f77a2 Mon Sep 17 00:00:00 2001
From: matsu <covocovo893@gmail.com>
Date: Thu, 22 Oct 2026 07:20:50 +0900
Subject: [PATCH] spes-0152: sweettouchtest bit mask to bisect the touch probe
 hang

---
 bsd/dev/sweet_touch.c | 29 ++++++++++++++++++++++-------
 1 file changed, 22 insertions(+), 7 deletions(-)

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 8d6b401..da1d248 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -135,6 +135,12 @@ touch_wait(unsigned ms)
  * last step before a hang.
  */
 static unsigned touch_step_ms;
+/*
+ * spes: boot-arg sweettouchtest bit mask to bisect the probe hang:
+ * 1 skip the Goodix (0x5d) probes, 2 leave SE2 IRQ events disabled,
+ * 4 leave AVDD (GPIO98) off, 8 leave reset alone.
+ */
+static unsigned touch_test;
 
 static void
 touch_stage(const char *name)
@@ -655,7 +661,7 @@ touch_se_init(void)
 	touch_wr(st.se, SE_TX_WM, 0);
 	touch_wr(st.se, 0x810, 0);
 	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
-	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	touch_wr(st.se, SE_IRQ_EN, (touch_test & 2u) ? 0u : SE_EVENTS);
 	printf("SWEET TOUCH: packing tx=%#x/%#x rx=%#x/%#x gran=%#x\n",
 	    touch_rd(st.se, 0x260), touch_rd(st.se, 0x264),
 	    touch_rd(st.se, 0x284), touch_rd(st.se, 0x288), touch_rd(st.se, 0x254));
@@ -686,6 +692,7 @@ touch_thread(void *arg, wait_result_t result)
 	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
 	touch_mode_set = PE_parse_boot_argn("sweettouchmode", &touch_mode, sizeof(touch_mode));
 	(void)PE_parse_boot_argn("sweettouchstep", &touch_step_ms, sizeof(touch_step_ms));
+	(void)PE_parse_boot_argn("sweettouchtest", &touch_test, sizeof(touch_test));
 	printf("SWEET TOUCH: starting in %u s\n", delay_s);
 	touch_wait(delay_s * 1000u);
 	touch_stage("map");
@@ -715,21 +722,29 @@ touch_thread(void *arg, wait_result_t result)
 	touch_stage("power: irq pin");
 	touch_gpio(TOUCH_PIN_IRQ, 0, 3, 3, false, false);       /* CTL 0xc3 */
 	touch_stage("power: avdd gpio98");
-	touch_gpio(TOUCH_PIN_AVDD, 0, 3, 3, true, true);        /* CTL 0x2c3, high */
+	if (!(touch_test & 4u)) {
+		touch_gpio(TOUCH_PIN_AVDD, 0, 3, 3, true, true);        /* CTL 0x2c3, high */
+	}
 	touch_stage("power: i2c pins");
 	touch_gpio(6, 1, 0, 0, false, false);                   /* qup2 SDA, CTL 0x4 */
 	touch_gpio(7, 1, 0, 0, false, false);                   /* qup2 SCL */
-	touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, false);      /* CTL 0x2c3, low */
+	if (!(touch_test & 8u)) {
+		touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, false);      /* CTL 0x2c3, low */
+	}
 	touch_wait(20);
-	touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, true);
+	if (!(touch_test & 8u)) {
+		touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, true);
+	}
 	touch_wait(250);
 	touch_stage("probe");
-	uint8_t gid[32], legacy[32], fid1 = 0, fid2 = 0;
+	uint8_t gid[32] = {0}, legacy[32] = {0}, fid1 = 0, fid2 = 0;
 	st.probing = true;
-	int ge = touch_probe_info(GOODIX_PID_REG, gid);
+	int ge = (touch_test & 1u) ? ENXIO : touch_probe_info(GOODIX_PID_REG, gid);
 	printf("SWEET TOUCH: probe 0x5d err=%d pid=%02x%02x%02x%02x fw=%02x.%02x.%02x.%02x irq=%#x\n",
 	    ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
-	(void)touch_probe_info(0x8240, legacy);
+	if (!(touch_test & 1u)) {
+		(void)touch_probe_info(0x8240, legacy);
+	}
 	int fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
 	int fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
 	printf("SWEET TOUCH: probe 0x38 err=%d/%d chip-id=%02x:%02x irq=%#x\n",
-- 
