From 5b1d017633f083c959d0ce0e280925b70ab0338c Mon Sep 17 00:00:00 2001
From: matsu <covocovo893@gmail.com>
Date: Wed, 21 Oct 2026 23:56:18 +0900
Subject: [PATCH] spes-0142: sweetautoreboot=SECS flushes the log and resets
 into fastboot

---
 bsd/dev/sweet_ufs.c | 51 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 143db60..fed1e37 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -853,6 +853,40 @@ static uint64_t _Atomic sweet_log_total;
 static int sweet_log_chan;
 static uint32_t sweet_log_secs = SWEET_LOG_SECS;
 
+/*
+ * spes: boot-arg sweetautoreboot=SECS. After SECS seconds of uptime the log
+ * thread flushes once more and resets into fastboot (same restart reason and
+ * PS_HOLD write as the shim), so a PC script can pull the log from recovery
+ * and boot the next image without anyone touching the phone.
+ */
+#define SWEET_IMEM_PA            0x0c125000u    /* qcom,msm-imem; restart_reason at +0x65c */
+#define SWEET_RESTART_OFF        0x65cu
+#define SWEET_RESTART_BOOTLOADER 0x77665500u
+#define SWEET_PSHOLD_PA          0x0440b000u
+static uint64_t sweet_reboot_at;
+
+static void
+sweet_reboot_check(void)
+{
+	if (!sweet_reboot_at || mach_absolute_time() < sweet_reboot_at) {
+		return;
+	}
+	vm_offset_t imem = ml_io_map(SWEET_IMEM_PA, 0x1000);
+	vm_offset_t pshold = ml_io_map(SWEET_PSHOLD_PA, 0x1000);
+	if (!imem || !pshold) {
+		printf("SWEET REBOOT: MMIO mapping failed\n");
+		sweet_reboot_at = 0;
+		return;
+	}
+	*(volatile uint32_t *)(imem + SWEET_RESTART_OFF) = SWEET_RESTART_BOOTLOADER;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)pshold = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (;;) {
+		__asm__ volatile ("wfi");
+	}
+}
+
 /* Called for all console output, any context: never blocks. */
 void sweet_log_append(const char *c, int size);
 
@@ -909,6 +943,7 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
 	uint64_t flushed = 0, seq = 0;
+	bool reboot_announced = false;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
 
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
@@ -917,6 +952,7 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
 		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
 		if (total == flushed) {
+			sweet_reboot_check();   /* only from a fully flushed log */
 			continue;
 		}
 		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
@@ -951,6 +987,14 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 			return;
 		}
 		flushed = total;
+		if (sweet_reboot_at && mach_absolute_time() >= sweet_reboot_at) {
+			if (reboot_announced) {
+				sweet_reboot_check();   /* the announcement is on disk */
+			}
+			printf("SWEET REBOOT: sweetautoreboot reached, resetting to fastboot\n");
+			reboot_announced = true;
+			wakeup(&sweet_log_chan);        /* flush that line, then reset */
+		}
 	}
 }
 
@@ -968,6 +1012,13 @@ sweet_log_start(void)
 	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
 		sweet_log_secs = SWEET_LOG_SECS;
 	}
+	uint32_t reboot_secs = 0;
+	if (PE_parse_boot_argn("sweetautoreboot", &reboot_secs, sizeof(reboot_secs)) && reboot_secs) {
+		uint64_t delta;
+		nanoseconds_to_absolutetime((uint64_t)reboot_secs * NSEC_PER_SEC, &delta);
+		sweet_reboot_at = mach_absolute_time() + delta;
+		printf("SWEET REBOOT: to fastboot after %u s\n", reboot_secs);
+	}
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
-- 
