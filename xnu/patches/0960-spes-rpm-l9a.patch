 	{
 		int l9a = 1;
 		(void)PE_parse_boot_argn("sweettouchl9a", &l9a, sizeof(l9a));
-		printf("SWEET TOUCH: L9A %s\n", !l9a ? "left alone (sweettouchl9a=0)" :
-		    sweet_pmic_l9a_on() ? "on" : "NOT on");
+		bool on = false;
+		if (l9a) {
+			/* SPMI only if APPS owns it; otherwise ask the RPM, as Linux's rpm-smd-regulator does */
