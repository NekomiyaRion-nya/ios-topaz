From 17fac32f7c3af17d2692c7c6b8ae68a8215b7bcc Mon Sep 17 00:00:00 2001
From: matsu <covocovo893@gmail.com>
Date: Thu, 22 Oct 2026 02:05:16 +0900
Subject: [PATCH] spes-0147: accept the FT3418 (id 34:18) and use its unscaled
 coordinates

---
 bsd/dev/sweet_touch.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 5c0ca4b..7751c33 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -41,6 +41,7 @@ void sweet_touch_init(void);
 #define TOUCH_MAX        10u
 /* spes: 0 = topaz raw scale (1.25x panel), 1 = raw in panel pixels (boot-arg sweettouchmode) */
 static unsigned touch_mode;
+static bool touch_mode_set;
 #define TOUCH_GOODIX     1
 #define TOUCH_FTS        2
 /* GT9896 is Yellowstone in Xiaomi sweet-r-oss, not the Berlin protocol. */
@@ -653,7 +654,7 @@ touch_thread(void *arg, wait_result_t result)
 	 * below hangs the SoC, the persistent log and the GUI got there first.
 	 */
 	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
-	(void)PE_parse_boot_argn("sweettouchmode", &touch_mode, sizeof(touch_mode));
+	touch_mode_set = PE_parse_boot_argn("sweettouchmode", &touch_mode, sizeof(touch_mode));
 	(void)PE_parse_boot_argn("sweettouchstep", &touch_step_ms, sizeof(touch_step_ms));
 	printf("SWEET TOUCH: starting in %u s\n", delay_s);
 	touch_wait(delay_s * 1000u);
@@ -720,7 +721,15 @@ touch_thread(void *arg, wait_result_t result)
 	st.d_fid1 = fid1;
 	st.d_fid2 = fid2;
 	bool goodix = !ge && gid[0] == '9' && gid[1] == '8' && gid[2] == '9' && gid[3] == '6';
-	bool fts = !fe1 && !fe2 && fid1 == 0x54 && fid2 == 0x52;
+	/*
+	 * spes ships an FT3418 (Xiaomi spes-r-oss ft3418_i2c: _FT3418 0x34180481,
+	 * id 34:18) that reports panel pixels directly (no 1.25x scale).
+	 */
+	bool ft3418 = !fe1 && !fe2 && fid1 == 0x34 && fid2 == 0x18;
+	bool fts = (!fe1 && !fe2 && fid1 == 0x54 && fid2 == 0x52) || ft3418;
+	if (ft3418 && !touch_mode_set) {
+		touch_mode = 1;
+	}
 	if (st.dead || goodix == fts) {
 		printf("SWEET TOUCH: no unique supported IC (goodix=%d fts=%d dead=%d); stopping\n",
 		    goodix, fts, st.dead);
@@ -729,7 +738,7 @@ touch_thread(void *arg, wait_result_t result)
 	st.kind = goodix ? TOUCH_GOODIX : TOUCH_FTS;
 	touch_stage("polling");
 	printf("SWEET TOUCH: selected %s, 1080x2400, poll=10ms irq-hint=%d\n",
-	    goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", st.irq_hint);
+	    goodix ? "GT9896 Yellowstone" : ft3418 ? "Focaltech FT3418 34:18" : "Focaltech 54:52", st.irq_hint);
 	unsigned errors = 0, ticks = 0, polls = 0;
 	while (!st.dead) {
 		if (st.diag == 2 && ++polls == 3000) {  /* ~30 s at 10 ms */
-- 
2.52.0.windows.1

